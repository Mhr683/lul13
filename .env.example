# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional. For Google Maps and Places Address Auto-Detection.
VITE_GOOGLE_MAPS_API_KEY="AIzaSy..."

# RESEND_API_KEY: Required for sending real transactional emails via Resend.
RESEND_API_KEY="re_123456789..."

# EMAIL_FROM: Verified sender email address in Resend (e.g., "Store Orders <orders@yourdomain.com>" or "onboarding@resend.dev").
EMAIL_FROM="Store Orders <onboarding@resend.dev>"

# STORE_OWNER_EMAIL: Email address to receive notifications for new incoming orders (e.g., "owner@example.com").
STORE_OWNER_EMAIL="owner@example.com"

# FIREBASE_SERVICE_ACCOUNT: Optional. Service account JSON (or base64 of it) for the store's Firebase project,
# so the server can save orders when the app runs under another Google account. Set it as a secret; never commit it.
FIREBASE_SERVICE_ACCOUNT=""
# FIREBASE_SERVICE_ACCOUNT_FILE: Optional alternative for local runs: full path to the key file (keep it outside the repo).
FIREBASE_SERVICE_ACCOUNT_FILE=""

# ---- Ad platforms (Admin → Traffic & Conversion → Ads & ROAS). Leave empty to switch a platform off.
# Meta (Facebook / Instagram) Marketing API + Conversions API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# Google Ads API (OAuth refresh token of a user with access to the ad account)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# TikTok Marketing API
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_CURRENCY=USD
